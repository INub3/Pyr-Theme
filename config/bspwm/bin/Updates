#!/bin/sh
# =============================================================
# Author: gh0stzk
# Repo:   https://github.com/gh0stzk/dotfiles
# Date:   06.04.2025 09:41:28
#
# Updates - Check for pending apt upgrades and sync the updates module
#           in polybar.
# Features:
#   ✔ Shows the number of available upgrades in polybar
#   ✔ Used by the pyr-updates systemd timer. --sync-polybar
#
# Note: the count reflects the package lists as of the last `apt update`.
#       Refreshing them requires root, so this script never does it itself;
#       Debian keeps them current through APT::Periodic / unattended-upgrades.
#
# Dependencies:
#   → apt, polybar
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

UPDATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/Updates.txt"

# Main verification function
check_updates() {
    # `apt list --upgradable` needs no root; drop the "Listing..." header and
    # any blank line so the count is exactly the number of packages.
    updates=$(apt list --upgradable 2>/dev/null | sed -e '1{/^Listing/d}' -e '/^$/d')

    if [ -n "$updates" ]; then
        total=$(printf '%s\n' "$updates" | wc -l)
    else
        total=0
    fi

    mkdir -p "$(dirname "$UPDATE_FILE")"
    echo "$total" > "$UPDATE_FILE"

    # Sends the signal to the polybar module to update the data.
    if pgrep -x polybar >/dev/null; then
        polybar-msg action updates hook 0 >/dev/null 2>&1
    fi
}

list_updates() {
    check_updates
    if [ "$total" -gt 0 ]; then
        printf "\033[1m\033[33mThere are %s updates available:\033[0m\n" "$total"
        printf "\n%s\n" "$updates"
    else
        printf "\033[1m\033[32m¡Your system is already updated!\033[0m\n"
    fi
    exit 0
}

# Execute it accordingly
case "${1:-}" in
    --sync-polybar)
        check_updates ;;
    --print-updates)
        list_updates ;;
    *)
        echo "$(basename "$0") [OPTIONS]"
        echo "  --sync-polybar      Sync data & polybar module"
        echo "  --print-updates     Sync data, polybar module & print available apps to update"
        exit 1
    ;;
esac
