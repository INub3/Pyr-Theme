#!/bin/sh
# =============================================================
# Script to control prefered apps to launch for all themes
# Author:  z0mbi3
# Repo:    https://github.com/gh0stzk/dotfiles
# Date:    24.04.2025
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

# Launch a GUI app, or say why nothing happened. Several of these are not
# installed by install.sh (thunar, telegram-desktop) or carry a different
# binary name on Debian, and a missing one used to fail silently: the
# keybinding simply did nothing.
launch() {
	if [ -z "$1" ] || ! command -v "$1" >/dev/null 2>&1; then
		dunstify -u critical "Pyr" "${1:-That application} is not installed" 2>/dev/null ||
			echo "${1:-That application} is not installed" >&2
		exit 1
	fi
	"$@"
}

# Debian ships Firefox as `firefox-esr`; upstream builds use `firefox`.
browser_bin() {
	for b in firefox firefox-esr chromium brave-browser; do
		if command -v "$b" >/dev/null 2>&1; then
			echo "$b"
			return 0
		fi
	done
}

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--update)
		Term --update
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--pass)
		RofiPass
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--android)
		AndroidMount
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--music)
		Term --music
		;;
	--fetch)
		Term --fetch
		;;
	--scratch)
		Bspwm-ScratchPad
		;;
		# Apps
	--filemanager)
		launch thunar
		;;
	--browser)
		launch "$(browser_bin)"
		;;
	--editor)
		launch geany
		;;
	--telegram)
		launch telegram-desktop
		;;
	--whats)
		launch "$(browser_bin)" -new-tab https://web.whatsapp.com/
		;;
	--soundcontrol)
		launch pavucontrol
		;;
	*)
		echo "Invalid Option"
		;;
esac
