#!/bin/sh
# =============================================================
# bspc-listener - Propagate bspwm events to the status bar.
#
# The polybar `bspwm` module is type = internal/bspwm and refreshes itself
# from bspwm's own socket, so this listener only nudges the custom/ipc
# modules that cannot notice window changes on their own.
#
# It deliberately does NOT run `eww reload`: none of the eww widgets
# (cheatsheet, player, profilecard) display bspwm state, and reloading the
# whole config on every focus change re-renders every open window.
# =============================================================

export PATH="$HOME/.config/bspwm/bin:$HOME/.local/bin:$PATH"

BSPC_SUBSCRIBE_EVENTS="desktop_focus node_add node_remove node_transfer monitor_focus"

bspc subscribe $BSPC_SUBSCRIBE_EVENTS | while read -r _event; do
    if pgrep -x polybar >/dev/null 2>&1; then
        polybar-msg cmd redraw >/dev/null 2>&1 || true
    fi
done
